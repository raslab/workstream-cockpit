# Workstream Cockpit example environment

# Runtime
NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_PORT=3002
PORT=3001
LOG_LEVEL=info

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=workstream
POSTGRES_PASSWORD=change-me
POSTGRES_DB=workstream_cockpit
DATABASE_URL=postgresql://workstream:<postgres-password>@postgres:5432/workstream_cockpit?schema=public

# Frontend / CORS
FRONTEND_URL=http://localhost:3002
CORS_ORIGIN=http://localhost:3002
VITE_API_URL=/

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
# Optional comma-separated allowlists. Leave both empty to allow any Google account.
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_DOMAINS=

# Sessions
# Required. Use a unique random value; production requires at least 32 characters and rejects weak defaults.
SESSION_SECRET=change-me-to-a-random-32-plus-character-value
SESSION_MAX_AGE=2592000000
SESSION_COOKIE_NAME=connect.sid
COOKIE_DOMAIN=

# Auth diagnostics
# Disabled by default. Set true only temporarily and avoid enabling in production.
AUTH_DEBUG_ENABLED=false

# Backups
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
GCP_PROJECT_ID=
GCP_BUCKET_NAME=
GCP_SERVICE_ACCOUNT_KEY_PATH=/app/config/gcp-service-account.json
