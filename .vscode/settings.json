{
    "chat.promptFilesRecommendations": {
        "speckit.constitution": true,
        "speckit.specify": true,
        "speckit.plan": true,
        "speckit.tasks": true,
        "speckit.implement": true
    },
    "chat.tools.terminal.autoApprove": {
        ".specify/scripts/bash/": true,
        ".specify/scripts/powershell/": true
    },
    // Jest Test Explorer Configuration (Backend)
    "jest.runMode": "on-demand",
    "jest.rootPath": "backend",
    "jest.jestCommandLine": "npm test --",
    "jest.outputConfig": "terminal-based",
    "jest.enable": true,
    "jest.coverageFormatter": "DefaultFormatter",
    // Vitest Configuration (Frontend)
    "vitest.enable": true,
    "vitest.commandLine": "npm test",
    "vitest.workspaceConfig": "frontend/vitest.config.ts",
    // Testing Configuration
    "testing.automaticallyOpenPeekView": "failureInVisibleDocument",
    "testing.openTesting": "neverOpen",
    // File Associations
    "files.associations": {
        "*.test.ts": "typescript",
        "*.test.tsx": "typescriptreact",
        "*.spec.ts": "typescript"
    },
    // Exclude test coverage from search
    "files.exclude": {
        "**/coverage": true,
        "**/.nyc_output": true
    },
    // Terminal Environment (for running tests from terminal)
    "terminal.integrated.env.linux": {
        "NODE_ENV": "test"
    },
    "terminal.integrated.env.osx": {
        "NODE_ENV": "test"
    },
    "terminal.integrated.env.windows": {
        "NODE_ENV": "test"
    },
    "testing.automaticallyOpenTestResults": "neverOpen"
}

