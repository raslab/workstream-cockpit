// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Person {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String
  pictureUrl String?  @map("picture_url")
  createdAt  DateTime @default(now()) @map("created_at")

  projects             Project[]
  personalAccessTokens PersonalAccessToken[]

  @@map("persons")
}

model PersonalAccessToken {
  id          String    @id @default(uuid())
  personId    String    @map("person_id")
  name        String
  tokenHash   String    @unique @map("token_hash")
  tokenPrefix String    @map("token_prefix")
  scopes      String[]
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@map("personal_access_tokens")
}

model Project {
  id                     String   @id @default(uuid())
  personId               String   @map("person_id")
  name                   String
  nextWorkstreamNumber   Int      @default(1) @map("next_workstream_number")
  nextStatusUpdateNumber Int      @default(1) @map("next_status_update_number")
  createdAt              DateTime @default(now()) @map("created_at")

  person          Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  categories      Category[]
  workstreams     Workstream[]
  statusUpdates   StatusUpdate[]
  nextSteps       NextStep[]
  tags            Tag[]
  views           View[]
  resourceChanges ResourceChange[]

  @@index([personId])
  @@map("projects")
}

model Category {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  name        String
  color       String
  emoji       String?
  description String   @default("") @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstreams Workstream[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("categories")
}

model Tag {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  name        String // Tag ID: lowercase with underscores (e.g., "alan_awake")
  displayName String   @map("display_name") // User-friendly name with spaces (e.g., "Alan Awake")
  color       String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
  @@map("tags")
}

model Workstream {
  id         String    @id @default(uuid())
  projectId  String    @map("project_id")
  number     Int       @map("public_number")
  categoryId String?   @map("category_id")
  parentId   String?   @map("parent_id")
  name       String
  context    String?   @db.Text
  state      String    @default("active")
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at")
  closedAt   DateTime? @map("closed_at")

  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category      Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  parent        Workstream?       @relation("WorkstreamHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  substreams    Workstream[]      @relation("WorkstreamHierarchy")
  statusUpdates StatusUpdate[]
  nextSteps     NextStep[]
  events        WorkstreamEvent[]

  @@unique([projectId, number])
  @@index([projectId])
  @@index([projectId, state])
  @@index([categoryId])
  @@index([parentId])
  @@map("workstreams")
}

model WorkstreamEvent {
  id           String   @id @default(uuid())
  workstreamId String   @map("workstream_id")
  eventType    String   @map("event_type")
  metadata     Json
  createdAt    DateTime @default(now()) @map("created_at")

  workstream Workstream @relation(fields: [workstreamId], references: [id], onDelete: Cascade)

  @@index([workstreamId])
  @@index([eventType])
  @@index([createdAt])
  @@map("workstream_events")
}

model StatusUpdate {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  number       Int      @map("public_number")
  workstreamId String   @map("workstream_id")
  status       String
  note         String?  @db.Text
  impact       String   @default("active")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workstream Workstream @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@index([workstreamId])
  @@index([projectId])
  @@index([createdAt])
  @@map("status_updates")
}

model NextStep {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  workstreamId String   @map("workstream_id")
  text         String
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstream Workstream @relation(fields: [workstreamId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([workstreamId, sortOrder])
  @@map("next_steps")
}

model View {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  config    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("views")
}

model ResourceChange {
  id            String   @id @default(uuid())
  sequence      BigInt   @unique @default(autoincrement())
  projectId     String   @map("project_id")
  resourceType  String   @map("resource_type")
  resourceId    String?  @map("resource_id")
  resourceLabel String?  @map("resource_label")
  operation     String
  workstreamId  String?  @map("workstream_id")
  metadata      Json?
  changedAt     DateTime @default(now()) @map("changed_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, changedAt])
  @@index([projectId, resourceType])
  @@index([projectId, workstreamId])
  @@map("resource_changes")
}
