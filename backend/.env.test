# Test Database Configuration
# This database is separate from the main development database
# and is used exclusively for running integration tests
#
# Prerequisites:
# 1. Ensure docker-compose is running: docker-compose up -d
# 2. Create docker-compose.override.yml with:
#    services:
#      postgres:
#        ports:
#          - "35268:5432"
#
# The test database URL uses:
# - Port 35268 (exposed via docker-compose.override.yml)
# - Database name: workstream_cockpit_test (separate from main DB)
# - Same credentials as main database (from .env)

DATABASE_URL="postgresql://postgres:postgres@host.docker.internal:35268/workstream_cockpit_test?schema=public"

# OAuth Configuration for Tests
# These are dummy values used only for testing
# The auth tests will mock the actual OAuth flow
GOOGLE_CLIENT_ID="test-client-id"
GOOGLE_CLIENT_SECRET="test-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"
SESSION_SECRET="test-session-secret"
